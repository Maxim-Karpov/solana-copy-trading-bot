# Settings file: save this as .env in the bot folder, OR as copybot.env in the
# folder above it (survives replacing the bot folder on updates). After an
# update, `npm run check-env` lists settings that are new since your copy.
#
# Solana & Bot configuration
# Any RPC provider works as long as its plan includes websocket subscriptions
# (logsSubscribe) — this bot needs both HTTP and WS access.
#
# Helius (recommended — free tier includes websockets, 1M credits/mo):
#   1. Sign up at https://dev.helius.xyz and create an API key
#   2. SOLANA_RPC="https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE"
#   3. Leave SOLANA_WS unset — it auto-derives to:
#      wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE
# Never share or commit your actual api-key value.
SOLANA_RPC=""               # your Solana RPC URL (http/https)
# SOLANA_WS=""               # optional: websocket RPC URL, if your provider uses a
                              # different host/path for websockets than for HTTP.
                              # Left unset, it's auto-derived from SOLANA_RPC by
                              # swapping the scheme (https:// -> wss://, http:// -> ws://).
                              # This is used for the trade-detection feed (see below) —
                              # pick an RPC provider whose plan supports websocket
                              # subscriptions (logsSubscribe) for reliable delivery.
                              # For Helius specifically, SOLANA_RPC and SOLANA_WS share
                              # the same host/path/query, so auto-derivation just works
                              # and you never need to set this explicitly.
# Optional: comma-separated list of additional RPC HTTP URLs to fail over to
# if SOLANA_RPC starts erroring (timeouts, 5xxs, rate limits, etc.). Leave
# unset (default) to disable — the bot then uses only SOLANA_RPC, exactly as
# before this feature existed. Websocket URLs are auto-derived from each
# fallback the same way as SOLANA_WS is from SOLANA_RPC. Good choices:
# Helius, QuickNode, Triton, Chainstack, Ankr, or as a last resort the
# public https://api.mainnet-beta.solana.com endpoint (low rate limits, so
# only useful as a rarely-hit fallback, never as your primary).
# SOLANA_RPC_FALLBACKS="https://your-fallback-1,https://your-fallback-2"
PRIVATE_KEY=""              # the private key to sign all txns
PUBLIC_KEY=""               # your wallet address = the public key of PRIVATE_KEY
                            # (checked at startup; the bot refuses to run on a mismatch)
BOT_MODE="COPY"             # either "COPY" or "SELLING"

# Copy‐Trading settings
# Trade detection connects directly to your Solana RPC's websocket
# (logsSubscribe filtered to COPY_WALLET) and classifies each transaction
# itself — no third-party indexer (CoinVera, Helius, etc.) required.
#
# A transaction is only ever mirrored if BOTH legs are present: the copied
# wallet's own SOL balance moved AND a token balance moved with it. A plain
# SOL transfer (sending/receiving SOL with no token involved) never matches
# this and is always ignored — nothing is copied just because SOL moved.
#
# Several wallets: separate them with commas, e.g.
# COPY_WALLET="4vw5...9Ud9,46Zk...HMbj". Every one is copied. Each position
# follows the sells of the wallet whose buy opened it; another wallet buying
# or selling a coin you already hold is ignored for that position.
# SKIP_REBUYS and ONLY_COPY_FIRST_BUY are tracked per wallet.
COPY_WALLET=""

# Minimum SOL amount for a detected BUY to be treated as real, rather than
# rent/dust noise — e.g. the copied wallet paying ~0.002 SOL of its own rent
# to open a token account while claiming an airdrop, which would otherwise
# look like a very small "buy" even though nothing was purchased.
# Sells are NOT filtered by this: when a token has crashed, the copy wallet's
# final exit can be worth less than this, and EXACT/STIERED positions need to
# see that sell to exit too. Also the smallest buy the bot will place after
# the risk caps clamp one down.
MIN_TRADE_SOL="0.003"

# --- Risk caps (apply to every TRADE_TYPE mode) ---
# Hard ceiling on any single buy. Whatever TRADE_TYPE computed (EXACT copying
# a huge wallet buy, a misconfigured BUY_AMOUNT, a high TIER_BUY_CONFIG tier,
# etc.), the actual buy is clamped down to this — never skipped outright.
MAX_BUY_AMOUNT="11"          # in SOL

# Hard ceiling on total SOL committed at once: the remaining cost of all open
# positions PLUS any buys still in flight (so several buys arriving together
# can't jointly blow through it). A new buy is clamped to whatever room is
# left; if less than MIN_TRADE_SOL is left, the buy is skipped entirely.
MAX_TOTAL_EXPOSURE="15"      # in SOL

# At most this many positions open at once, counting buys still in flight.
# A copy buy that would open one more is skipped (adding to a coin you
# already hold still works). Default 2; 0 = no limit.
# MAX_OPEN_POSITIONS="2"

# After the bot sends a buy, skip any other copy buy that arrives within this
# many seconds (any coin, any copy wallet). A buy that was skipped or failed
# before sending doesn't count. Default 5; 0 = off.
# BUY_COOLDOWN_SEC="5"

TRADE_TYPE="SAFE"                                      # "EXACT", "SAFE", "TIERED", or "STIERED"
BUY_AMOUNT="0.01"                                      # in SOL (used only if TRADE_TYPE="SAFE")
TAKE_PROFIT="10"                                       # percent, e.g. 10% (used if SAFE or TIERED — NOT STIERED)
STOP_LOSS="5"                                          # percent, e.g. 5% (used if SAFE or TIERED — NOT STIERED)

# TRADE_TYPE modes, in full:
#   EXACT   - buy the exact SOL amount the copied wallet spent; on ANY sell by
#             the copied wallet, immediately dump 100% of our position. No
#             TP/SL of our own — fully mirrors the copied wallet's exit.
#   SAFE    - always buy BUY_AMOUNT SOL; exit only via our own TAKE_PROFIT /
#             STOP_LOSS (and trailing stop, if enabled). The copied wallet's
#             sells are ignored entirely.
#   TIERED  - buy size scales with how much SOL the copied wallet spent (see
#             TIER_BUY_CONFIG below); exit via our own TAKE_PROFIT / STOP_LOSS,
#             same as SAFE. The copied wallet's sells are ignored.
#   STIERED - buy size scales like TIERED, but sells MIRROR the copied
#             wallet's sells proportionally instead of using TP/SL: if they
#             sell 100% of their stack we close our position fully; if they
#             sell e.g. 40% of their stack, we sell 40% of ours and keep the
#             rest open. Requires TIER_BUY_CONFIG. TAKE_PROFIT/STOP_LOSS are
#             not used in this mode — the copied wallet's own sells are the
#             only exit signal.

# TIER_BUY_CONFIG (used if TRADE_TYPE="TIERED" or "STIERED")
# JSON array of { "maxSol": <exclusive upper bound of the copied wallet's SOL
# buy size, or null for the top/catch-all tier>, "buyAmount": <SOL we spend> }.
# Example below: copied wallet buys <0.5 SOL -> we spend 0.05 SOL;
#                copied wallet buys 0.5-2 SOL -> we spend 0.15 SOL;
#                copied wallet buys >2 SOL    -> we spend 0.3 SOL.
# Exactly one tier must have "maxSol": null, and it must be the highest tier.
# Tiers can be listed in any order; the bot sorts them automatically.
TIER_BUY_CONFIG='[{"maxSol":0.5,"buyAmount":0.05},{"maxSol":2,"buyAmount":0.15},{"maxSol":null,"buyAmount":0.3}]'

# === TRAILING STOP LOSS CONFIGURATION ===
ENABLE_TRAILING_STOP=false        # Enable/disable trailing stop loss
TRAILING_STOP_DISTANCE=10.0      # Distance below peak price to trail (%)
TRAILING_STOP_ACTIVATION=20.0    # Minimum profit before trailing starts (%)

# Security feature: allow multiple buys per mint?
# true  → a second (or third…) buy of the same mint is ADDED to the existing
#         position (tokens, cost and a weighted-average entry price).
# false → ignore any further buys for a mint once a position already exists.
ENABLE_MULTI_BUY="false"

# Treat the copy wallet moving a token OUT without selling it for SOL — sending
# it to another wallet, burning it, or swapping it into a different token — as
# an exit. For EXACT and STIERED positions it's mirrored exactly like a sell of
# the same percentage (EXACT: any move-out closes the position in full, same as
# any sell; STIERED: they move out 40% of their bag -> we sell 40% of ours).
# SAFE/TIERED positions ignore it, as they ignore copy sells.
# Set "false" to mirror only real sells.
MIRROR_TRANSFERS="true"

# STIERED only: when the copy wallet makes its FIRST sell (or transfer out,
# if MIRROR_TRANSFERS is on) of a coin, sell ALL of ours instead of the same
# percentage. "false" (default) mirrors each partial sell.
# A position you've tapped Keep on is never sold by this.
# FULL_EXIT_ON_COPY_SELL="false"

# Only copy the copy wallet's FIRST buy of a coin (default on): if it already
# held the coin (you started the bot mid-trade, or our first buy failed), its
# later buys are skipped. Read from its own transactions plus one snapshot of
# its coins at startup, so buys make no extra call. When you already hold the
# coin, ENABLE_MULTI_BUY decides instead. "false" = copy every buy.
# ONLY_COPY_FIRST_BUY="true"

# Skip a copy buy if our price per token would be more than this % above the
# copy wallet's (other copy bots got in first and pumped it). Checked from the
# direct builder's own quote before anything is sent, so it adds no time.
# Only direct builds (Pump.fun curve, PumpSwap, Raydium AMM/CPMM/CLMM) can be
# checked; other routes buy without the check. Empty = off (default).
# MAX_ENTRY_PREMIUM_PCT="30"

# Instant buy filters. They use what the direct builder already knows about
# the coin while building (its curve or pool, its creator), so they add no
# time and no lookups. Each is off when empty (default).
# Market cap in SOL just before our buy (after the copy wallet's own buy on
# the websocket feed). A Pump.fun coin launches at ~28 SOL and graduates at
# ~410 SOL. With either limit set, a coin whose market cap can't be read
# instantly (no direct build: Raydium LaunchLab, SolanaPortal, Jupiter) is
# skipped.
# MIN_MARKET_CAP_SOL="30"
# MAX_MARKET_CAP_SOL="100"
# Ignore the copy wallet's buys smaller than this (SOL), e.g. test buys.
# MIN_COPY_BUY_SOL="1"
# Never buy coins made by these wallets (comma-separated addresses).
# BLOCKED_CREATORS="Addr1...,Addr2..."

# Only buy if our transaction lands within this many slots (blocks) of the
# copy wallet's buy; 0 = the same block. The buy carries a slot guard (an
# instruction for Lighthouse, a public on-chain assertion program): if it
# lands later, the whole transaction is undone on-chain, so nothing is bought
# and only the network fee is paid (the tip is undone too). A buy that is
# already clearly too late isn't sent at all. Pump.fun curve and PumpSwap
# buys only (others are skipped). Needs shreds to be useful at 0 or 1: the
# websocket feed reports his buy after his block has ended. Empty = off.
# MAX_SLOTS_BEHIND="0"

# Where each slot's leader is. Solana publishes which validator leads each
# slot, and every validator's address; the bot places those addresses on a
# map (free lookup at ip-api.com, cached for a week in
# data/leader-locations.json) and compares them with this server's location.
# Each shred buy's [Timing] line then names its slot leader's city and
# distance, and the summary splits the same-block rate by distance:
#   "by leader distance: ≤100 km 8/10, 100–1,500 km 3/7, >1,500 km 0/5"
# On by default; "false" turns it off (no lookups).
# LEADER_INFO="true"
# Skip a buy when the leader of his slot (and of the next MAX_SLOTS_BEHIND
# slots) is further than this many km from this server: such buys almost
# always arrive too late and are cancelled by the slot guard, but still pay
# their priority fee. From Frankfurt: 100 = Frankfurt only; 400 = also
# Amsterdam (~365 km), Brussels and Zurich (all a few ms away). A leader whose
# location isn't known is never skipped. Empty (default) = off.
# LEADER_MAX_KM="400"
# This server's location as "latitude,longitude" (default: looked up from
# its IP address). Frankfurt is "50.11,8.68".
# LEADER_HOME=""

# Quick flip: sell the whole position this many seconds after our buy
# confirms, whatever the copy wallet does. Copy-sells before then still apply.
# 0 = off (default).
# SELL_AFTER_SECONDS="5"

# Instant sell: sell the whole position the moment our buy lands, to catch the
# first or second 1s candle. The buy is checked every 100 ms and the sell is
# sent as soon as it shows as executed ("processed"), without waiting for
# confirmation; the position is recorded and closed by that sell as usual,
# and if it fails the bot sells again the normal way. Overrides
# SELL_AFTER_SECONDS. Default "false".
# INSTANT_SELL="true"
# Wait this long (ms) after the buy lands before selling (e.g. 1000 for the
# second candle). Default 0.
# INSTANT_SELL_DELAY_MS="0"

# Keep a recent blockhash and Pump.fun's config fetched in the background so
# a direct buy needs ONE network round trip instead of three (saves ~100-200
# ms per buy). Costs ~3 RPC calls a minute (~6k Helius credits a day).
# With DETECTION_COMMITMENT="processed", a copied Pump.fun buy is then built
# with NO round trip at all, from the copy wallet's own trade record. It
# also runs a practice build (never sent) every 30s so the buy code stays fast.
# "false" = fetch everything when a trade happens.
# PREWARM="true"

# PnL without fixed costs: compare what the swaps paid and returned, leaving
# out network/priority fees, Jito/Sender tips and token-account deposits
# (refundable). Pool trading fees and coin taxes stay in (part of the price).
# The log also shows the figure including them. "false" = wallet in/out.
# PNL_EXCLUDE_FEES="true"

# Don't follow the copy wallet back into a coin it has already exited:
#   "off"  - always copy its buys (default)
#   "full" - once it has sold (or moved out) its WHOLE bag of a coin, ignore
#            its later buys of that coin
#   "any"  - once it has sold (or moved out) ANY of a coin, even a partial
#            sell, ignore its later buys of that coin
# Exited coins are remembered in data/exited-mints.txt, so this holds across
# restarts; deleting that file clears the list.
SKIP_REBUYS="off"

# When to act on the copy wallet's trades:
#   "confirmed" (default) - once the network has confirmed the trade.
#   "processed" - as soon as it is first processed, roughly 0.5-1s sooner.
#     Pump.fun bonding-curve buys/sells are read straight from the live
#     notification, with no extra lookup for buys and one balance check for
#     sells. Other DEXes and transfers still wait for confirmation.
#     Risk: very occasionally a processed transaction is dropped and never
#     confirms, and you'd have copied a trade that didn't actually happen.
DETECTION_COMMITMENT="confirmed"

# Which live feed reports the copy wallet's transactions:
#   "logs" (default) - the standard feed (logsSubscribe), works with any
#     provider and plan. It also delivers every FAILED transaction and all
#     spam that merely mentions the wallet, and providers like Helius bill
#     websocket data by the MB (see the [Usage] log line).
#   "transaction" - Helius transactionSubscribe (Developer plan or higher):
#     failed transactions are filtered out by Helius before they're sent, and
#     each message carries the whole transaction, so no trade needs a lookup
#     on any DEX (Meteora, Raydium, PumpSwap... as fast as Pump.fun). Spam
#     signed by others is dropped on arrival. If the provider refuses it
#     (e.g. free plan), the bot says so and uses "logs" for that run.
#     Compare the [Usage] lines of both to see which is cheaper for you.
# DETECTION_FEED="logs"

# Shred stream: sees the copy wallet's trades as the slot leader produces
# them, typically a few hundred ms before the websocket feed above, which
# keeps running alongside it. Empty = off (default). Three sources; list
# several, comma-separated, to run them side by side (first report wins, and
# [Race] lines say which was faster and by how much), e.g.
# SHRED_SOURCE="shreder,helius-preprocessed":
#   "helius-preprocessed" - Helius preprocessedSubscribe (any PAID Helius
#     plan, 0.1 credits per message). Helius decodes the shreds and sends only
#     transactions that mention the copy wallet, so it's light on a small VPS.
#     Uses the API key in your Helius SOLANA_RPC (or SHRED_STREAM_TOKEN).
#   "jito-grpc" - decoded shreds over gRPC in the Jito ShredStream format
#     (ShredstreamProxy/SubscribeEntries) at SHRED_STREAM_URL: a provider's
#     endpoint, or Jito's shredstream-proxy run next to the bot to decode raw
#     UDP shreds (then SHRED_STREAM_URL="http://127.0.0.1:9999"). Carries every
#     transaction on Solana: heavy bandwidth.
#   "shreder" - Shreder's decoded shreds (paid, has a trial) at SHREDER_URL.
#     Shreder filters to the copy wallets, so it's light like Helius. Access
#     is by this server's public IPv4 address (give it to Shreder; see it with
#     curl -4 -s https://ifconfig.me), no token. Check it works with
#     npm run shreder-check before starting the bot.
# SHRED_SOURCE="helius-preprocessed"
# shreder: the address Shreder gave you, e.g. "http://fra1.shreder.xyz:9991".
# SHREDER_URL=""
# jito-grpc: the provider's address, e.g. "https://host:443" (TLS) or
# "http://1.2.3.4:9999" (plain). helius-preprocessed: leave empty.
# SHRED_STREAM_URL=""
# jito-grpc: the access token. helius-preprocessed: optional, your Helius API
# key if SOLANA_RPC isn't a Helius URL.
# SHRED_STREAM_TOKEN=""
# Header the token is sent in (jito-grpc; most providers use x-token).
# SHRED_STREAM_AUTH_HEADER="x-token"
# Shreds show a trade before it runs, so the copy wallet's buy can still fail
# or never land after we copied it. "true" (default): sell ours straight
# away. "false": Telegram alert only.
# SHRED_SELL_IF_COPY_FAILED="true"
# With a shred source on, copy ONLY the buys the shred stream reports: a buy
# the websocket feed reports first arrives too late to be worth it. While the
# shred feed is down nothing is bought (you get a Telegram alert after 30s).
# Sells and exits always come from both feeds. "false": buy from either feed.
# SHRED_BUYS_ONLY="true"
# helius-preprocessed bills every message (0.1 credits), spam that mentions
# the copy wallet included. If more than this many arrive in a minute, the
# shred feed stops for the run (Telegram alert) to save credits. 3000 a
# minute is ~430k credits a day. 0 = no limit.
# SHRED_MAX_MSGS_PER_MIN="3000"
# Helius feeds (helius-preprocessed shreds, and DETECTION_FEED="transaction"):
# leave out transactions that mention any of these accounts (comma-separated),
# e.g. a spam program that keeps mentioning the copy wallet. The [Shreds]
# summary (and the safety-stop message) lists candidates: accounts in most of
# the messages that never appear in the copy wallet's own transactions.
# Check on Solscan that a candidate isn't in his own trades before adding it.
# SHRED_EXCLUDE_ACCOUNTS=""
# Build Pump.fun buys copied from the shreds without looking the coin up
# (saves the one RPC round trip, ~20-60 ms). The buy becomes
# buy_exact_sol_in: exactly your buy amount in, and at least as many tokens as
# you'd get at MAX_MARKET_CAP_SOL (required), so the market cap limit is
# checked on-chain and SLIPPAGE isn't used for these buys. The coin's details
# come from the copy wallet's transaction: for router buys, his first few
# confirmed buys teach the bot where the router keeps the creator account.
# Whenever something can't be worked out (or MIN_MARKET_CAP_SOL is set, which
# needs a lookup) the buy is built the normal way. Default "false".
# SHRED_FAST_BUY="true"
# SHRED_FAST_BUY buys are written straight into transaction bytes instead of
# through Pump.fun's SDK and web3.js: the same transaction, byte for byte, in
# ~0.3 ms instead of ~2 ms (and ~1 ms instead of 5-15 ms right after a quiet
# spell). Checked against the SDK's version at startup and every 30 s; if
# they ever differ (e.g. a Pump.fun upgrade), it switches itself off and says
# so. "false" = always the SDK way. Default "true".
# HAND_BUILT_BUYS="true"

# Coins whose Pump.fun curve is paired to a token other than SOL (the PUMP
# token, a stock token...). Off by default: such coins are skipped. List the
# quote tokens' mint addresses (comma-separated) to buy them in the copy
# wallet's block like any other coin, e.g. the PUMP token:
#   QUOTE_TOKENS="pumpCmXqMfrsAkQ5r49WcJnRayYRqmXz6ae8H7H9Dfn"
# How it works: the bot keeps a reserve of each listed token worth
# QUOTE_TOKEN_RESERVE_SOL (bought through Jupiter at startup and topped up
# whenever it falls below half), and a copy buy spends your buy amount's worth
# straight from it: one instruction, no swap at buy time, slot guard as usual.
# Selling pays out in that token, which goes back into the reserve. Amounts and
# PnL are valued in SOL at the token's current Jupiter price.
# Needs DIRECT_PUMPFUN_SWAP="true" and JUPITER_API_KEY. Note the reserve is a
# holding of that token: its value moves with the token's price. Only curves
# are covered; a migrated coin paired to a token goes through SolanaPortal /
# Jupiter as before. Not verifiable from here on-chain: try with a small
# BUY_AMOUNT and reserve first.
# QUOTE_TOKENS=""
# How much of each quote token to keep, in SOL (default 1).
# QUOTE_TOKEN_RESERVE_SOL="1"
# Compute-unit budget of these buys (default 200000; they use more than a SOL
# buy). The log shows the units used after each trade: set this a little
# above that. The priority fee in total stays the same.
# QUOTE_COMPUTE_UNITS="200000"

# Close empty token accounts to get back their deposits. Each coin bought
# opens a token account holding ~0.002 SOL; once the coin is fully sold the
# bot closes it (about 30s later) and sweeps for any others every 30 minutes,
# including ones from before this feature. Only accounts with exactly zero
# tokens are closed; coins you hold are never touched. Default "true".
CLOSE_EMPTY_ACCOUNTS="true"

# Which services may build trades the direct builders (DIRECT_PUMPFUN_SWAP,
# DIRECT_RAYDIUM_SWAP) can't handle. Each takes "true", "false", "sells"
# (exits only) or "buys". The log names the route of every trade.
#
# SolanaPortal (default "true").
# USE_SOLANAPORTAL="true"
#
# Jupiter (default "false"): used when SolanaPortal can't build the trade
# (down, timeout, refusal), or straight away when SolanaPortal is off for
# that side. Covers Meteora, Orca, PumpSwap, non-SOL pairs... Only the
# building step is replaced: when SolanaPortal fails nothing has been sent,
# so it can't double a trade. Needs a free key: https://developers.jup.ag/portal
# JUPITER_FALLBACK="false"
JUPITER_API_KEY=""
# Jupiter's API address (default https://api.jup.ag/swap/v2).
# JUPITER_API_URL=""
#
# Example: fast direct-only BUYS, but exits that can always fall back:
#   USE_SOLANAPORTAL="sells"
#   JUPITER_FALLBACK="sells"
# If neither may build SELLS, a coin that stops qualifying for a direct build
# while held (e.g. its Pump.fun curve completes) can only be sold from a
# wallet app. The bot warns about this at startup.

# Skip coins with a "tax": a transfer fee (Token-2022 feature) taken on every
# buy and sell. Set a maximum percentage, e.g. "1" to skip anything taxed
# above 1%. Leave unset to not check. Pump.fun coins can't have one and are
# never checked; for other coins it's one quick lookup before the buy (if the
# lookup fails, the bot buys anyway). Any tax is also shown in the buy message.
# MAX_TOKEN_TAX_PCT="1"
# Stock-paired coins (priced in a tokenized stock such as NVDAx, e.g. StonkFun
# launches) are exempt from MAX_TOKEN_TAX_PCT. The bot recognises xStocks,
# PreStocks and a built-in list; add any other stock token mints here
# (comma-separated) if a new one appears. The pairing is shown in the buy message.
# STOCK_TOKEN_MINTS=""

# Start with buying PAUSED: the bot connects and sends you a Telegram message
# with a Resume button; nothing is bought until you tap it. Exits (copy-sells,
# your sell buttons) work while paused. Needs Telegram (ignored without it).
# Note: this also applies after an automatic restart (e.g. after a crash).
START_PAUSED="true"
# While paused, each buy copied from the shreds is still rehearsed up to the
# moment of sending (checks, build, signing; NOTHING is sent) and logged as a
# "[Timing] REHEARSAL" line, so a paused bot (e.g. on a test server) shows how
# fast it would have been. "false" = paused bots don't rehearse.
# PAUSED_REHEARSAL="true"
# A test copy of the bot that NEVER buys (e.g. on a second server, to compare
# its speed with the real one): permanently paused, works without Telegram
# (give a test bot its own Telegram bot token, or leave Telegram blank: two
# bots can't share one), every shred buy rehearsed and timed. Default "false".
# REHEARSE_ONLY="true"

# Most RPC calls per second the bot will make (0 = no limit). Set it a little
# under your RPC plan's limit, e.g. 8 for a 10-requests/second plan, 45 for 50.
# Trading calls always go first; background lookups use what's left.
RPC_MAX_RPS="8"

# Every this many minutes the log shows a [Usage] line: RPC calls by method,
# websocket data received, and an estimate of the credits used (Helius
# prices) and the daily rate. Also printed once when the bot stops.
# 0 = only when the bot stops.
# USAGE_LOG_MIN="10"

# === TELEGRAM CONTROL BOT (optional) ===
# Only YOU, in a private chat with your bot, can list or sell positions.
# Gives you a Telegram bot to view open positions and sell one with a button,
# instead of restarting the bot in BOT_MODE=SELLING. Also pushes buy
# notifications and sell notifications with PnL stats.
# Leave either of these unset (default) to disable the feature entirely —
# no telegram package is even touched.
#   1. Create a bot via @BotFather on Telegram, copy its token below.
#   2. Message @userinfobot (or similar) to get your own numeric chat id.
# Send /positions to your bot in Telegram to get the sell-button list.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# DEX Settings
PREFERRED_DEX=auto              # Options: "none", "auto", "pumpfun", "meteora", "raydium", "moonshot", "jupiter"

# Build & sign Pump.fun bonding-curve buys/sells directly on-chain using
# Pump.fun's own SDK, instead of calling SolanaPortal's trade-building API —
# cuts one network hop out of the buy/sell path. Only takes effect for
# dex="pumpfun" trades on a plain SOL-paired, legacy-SPL-Token bonding curve
# (the vast majority of pump.fun coins); anything else (an already-migrated
# curve, a Token-2022 "v2" coin, a non-SOL quote) automatically falls back
# to SolanaPortal, as does any error while building the direct transaction —
# so leaving this on never breaks trading, worst case it's a no-op.
# BETA: this path could not be tested against a live mainnet execution from
# where it was built. Leave it "false" (default) until you've verified it
# with a small BUY_AMOUNT yourself; watch the terminal logs — a successful
# direct build logs "Direct BUY/SELL txn sent", a fallback logs "falling
# back to SolanaPortal".
# Covers the Pump.fun bonding curve AND PumpSwap (where coins trade after
# graduating); the right one is picked from the copy wallet's transaction.
DIRECT_PUMPFUN_SWAP="false"

# Same idea, for Raydium: buys/sells on Standard (AMM v4 / CPMM) SOL-paired
# pools are built and signed directly via Raydium's own SDK instead of
# SolanaPortal. Concentrated-liquidity (CLMM) pools, or any build error,
# fall back to SolanaPortal automatically — same "can only help, never
# break a trade" guarantee as DIRECT_PUMPFUN_SWAP. Same BETA caveat too.
# Covers Raydium AMM v4, CPMM, CLMM and LaunchLab (bonding curve) pools
# paired with SOL.
DIRECT_RAYDIUM_SWAP="false"

# Execution parameters
SLIPPAGE="20"                                          # in percent
JITO_TIP="0.0005"                                      # in SOL
# Use the Jito region nearest to where the bot RUNS — every buy/sell waits on
# a round trip to it. Regions: london, amsterdam, dublin, frankfurt, ny, slc,
# singapore, tokyo (swap the word in the URL).
JITO_ENGINE="https://london.mainnet.block-engine.jito.wtf/api/v1/transactions"

# How to send transactions:
#   "jito"   (default) - straight to JITO_ENGINE, tipping JITO_TIP.
#   "sender" - Helius Sender: sends through Jito AND staked validator
#              connections at once, for a better chance of the earliest slot.
#              No Helius credits used; you pay SENDER_TIP per transaction
#              (instead of JITO_TIP) plus PRIORITY_FEE_SOL.
#              In the rare case a transaction can't be converted for Sender
#              (e.g. it would exceed Solana's size limit), it goes via Jito
#              as before, with a log line saying so.
SEND_VIA="jito"
# Sender region nearest the bot (fra, ams, lon, ewr, slc, sg, tyo).
SENDER_ENDPOINT="http://fra-sender.helius-rpc.com/fast"
SENDER_TIP="0.001"          # in SOL; Sender's minimum is 0.001
# Priority fee per transaction, in SOL. Sender requires one (default 0.0001
# with SEND_VIA="sender"). With Jito it's off unless you set it, and then
# applies only to transactions the bot builds itself (DIRECT_*_SWAP).
# PRIORITY_FEE_SOL="0.0001"
# Priority fee for BUYS, if different (default: PRIORITY_FEE_SOL). Inside a
# block the leader runs waiting transactions in order of priority fee per
# compute unit, so copy buys racing snipers for the same coin need a high one;
# sells rarely do. BUY_PRIORITY_FEE_PCT (optional) raises it to that % of the
# buy amount when that is more, e.g. "3" = 0.03 SOL on a 1 SOL buy while small
# test buys pay the fixed fee. Both are paid even when the slot guard cancels
# a buy (the Sender tip is not). Per compute unit = fee / PUMPFUN_COMPUTE_UNITS.
# BUY_PRIORITY_FEE_SOL="0.0001"
# BUY_PRIORITY_FEE_PCT=""
# Compute-unit budget of direct Pump.fun / PumpSwap trades. The priority fee
# above is spread over this budget, and block producers order transactions by
# fee PER UNIT. So a budget close to what a trade really uses puts you earlier
# in the block for the same fee. After each trade the log says how many units
# it used ("used 87,654 compute units of the 300,000 budgeted"). Set this to
# the most used plus a margin (~30%). Too low and a trade fails with "ran out
# of compute units". Default 300000.
# PUMPFUN_COMPUTE_UNITS="300000"
# Size each trade's compute limit to what that kind of trade has been using
# (learned from your own confirmed trades, kept in data/compute-units.json):
# the most any recent one used +10% (+3,000), with PUMPFUN_COMPUTE_UNITS as
# the ceiling and the limit used until a kind has been seen 3 times. The
# total priority fee stays the same, so the fee PER UNIT rises. A trade that
# runs out raises its kind's limit at once. Default "true".
# AUTO_COMPUTE_UNITS="true"
# Optional Sender extras:
#   SENDER_SWQOS_ONLY="true"  - skip the Jito route; minimum tip drops to 0.000005 SOL
#   SENDER_MEV_PROTECT="true" - avoid validators linked to sandwich attacks
#                               (may land slightly later)
SENDER_SWQOS_ONLY="false"
SENDER_MEV_PROTECT="false"

# Price‐checking
# Prices are fetched from DexScreener's public API (https://api.dexscreener.com) —
# free, no signup, no API key needed. Covers Pump.fun (bonding-curve + PumpSwap)
# and Raydium (AMM v4/CPMM/CLMM) pairs.
# (CoinVera is no longer used anywhere in this bot — neither for price checks
# nor for trade detection, which now runs on a raw Solana RPC websocket. No
# COINVERA_API key is needed at all.)
PRICE_CHECK_DELAY="5000"   # in milliseconds; how often to poll prices for open positions

# === ADVANCED (optional) — defaults are sensible, rarely need changing ===
# How long to wait for a buy/sell to confirm before treating it as not
# landed. A Solana transaction can't land after its blockhash expires
# (~60-90s), so there's little point waiting longer.
# CONFIRM_TIMEOUT_SEC="90"
#
# Every exit (TP/SL/trailing stop, copy-sell, Telegram, SELLING mode) is only
# recorded as closed once its sell CONFIRMS on-chain. A sell that fails or
# doesn't confirm is retried SELL_MAX_ATTEMPTS times, SELL_RETRY_DELAY_MS
# apart; if it still fails, the position stays OPEN, you get a Telegram alert
# (if enabled), and it's tried again after SELL_RETRY_COOLDOWN_MS — doubling
# after each further failure, up to 10 minutes, so a token that can't be
# sold at all doesn't spam you. SELL_MAX_ATTEMPTS must be at least 2.
# A STIERED partial sell that fails is remembered and retried the same way.
# SELL_MAX_ATTEMPTS="3"
# SELL_RETRY_DELAY_MS="2000"
# SELL_RETRY_COOLDOWN_MS="30000"
